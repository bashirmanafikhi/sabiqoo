{
  "name": "sabiqoo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "postinstall": "node scripts/patch-expo-sqlite.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "0.4.2",
    "@expo-google-fonts/epilogue": "0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.59.0",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.36.0",
    "expo": "^57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-modules-core": "^57.0.19",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^23.16.4",
    "intl-pluralrules": "^2.0.1",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^2.0.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^15.1.0",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "^0.10.1",
    "tailwindcss": "~3.2.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.3.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-react-native-a11y": "^3.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.19.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "moduleNameMapper": {
      "^nativewind/jsx-runtime$": "react/jsx-runtime",
      "^nativewind/jsx-dev-runtime$": "react/jsx-dev-runtime",
      "^react-native-reanimated$": "<rootDir>/node_modules/react-native-reanimated/mock.js",
      "^react-native-worklets$": "<rootDir>/node_modules/react-native-worklets/src/mock.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind|@tanstack/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/.*\\.d\\.ts$"
    ]
  }
}
